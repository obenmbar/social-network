      "updated": 1777790000000,
      "link": null,
      "locked": false,
      "text": "User A ──▶ WS emit('message', {to: UserB, content}) ──▶ WebSocket Hub ──▶ ChatService\n        │                                                           │\n        │                                                           ▼\n        │                                                       Save to DB\n        │                                                           │\n        ▼                                                           ▼\n   User B receives                                    Broadcast to User B's room\n   instant message                                    → UI updates instantly\n\nEvents: message, typing, online, read",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
