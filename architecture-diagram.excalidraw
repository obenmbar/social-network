    {
      "id": "lifecycle-text",
      "type": "text",
      "x": 35,
      "y": 1300,
      "width": 1050,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
