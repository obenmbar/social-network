      "updated": 1777790000000,
      "link": null,
      "locked": false,
      "text": "CREATE: POST /api/posts → Auth → PostHandler.CreatePost → PostService → PostRepository.Insert → DB\n\nLIKE: POST /api/posts/:id/like → Insert likes table → Create notification → Return count\n\nFEED: GET /api/posts/feed → Query posts from followed users → Pagination → Return feed",
      "fontSize": 11,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
